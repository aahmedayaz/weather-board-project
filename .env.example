# Copy to .env.local (git-ignored) and fill in.

# --- Client (inlined into the public bundle — never put secrets here) ---
# Validated by src/shared/lib/env.ts.
VITE_VAPID_PUBLIC_KEY=
# Origin of the deployed push worker (worker/), e.g. https://weatherboard-push.<you>.workers.dev
VITE_PUSH_WORKER_URL=

# --- Server only (Vercel Functions in api/; set them in Vercel project settings) ---
# RapidAPI key for GeoDB Cities, used by api/cities.ts.
RAPIDAPI_KEY=
# Optional override; defaults to wft-geo-db.p.rapidapi.com.
GEODB_API_HOST=
# OpenWeatherMap key for api/weather.ts. Optional: without it, Open-Meteo (keyless) answers.
OPENWEATHER_API_KEY=
